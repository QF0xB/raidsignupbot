DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# OAuth2 client secret of the Discord application, used for the web UI login.
DISCORD_CLIENT_SECRET=
# Only used in dev mode to register slash commands on a single server.
DISCORD_DEV_GUILD_ID=

# Used by compose.yaml
POSTGRES_PASSWORD=
TZ=Europe/Berlin
# Image tag to run, e.g. a commit SHA to pin or roll back.
BOT_TAG=latest
# Public host name of the web UI, routed by Traefik.
WEB_HOST=raids.example.com
